{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-ready:capability-contract:0.1",
  "title": "Agent Ready Capability Contract v0.1",
  "description": "Protocol-neutral metadata for an agent-operable product capability. Experimental; not an official web standard.",
  "type": "object",
  "required": ["id", "version", "name", "description", "inputSchema", "effect", "outputTrust", "confirmation"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "version": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
    "title": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "inputSchema": { "type": "object" },
    "effect": { "enum": ["read", "write", "consequential", "payment"] },
    "outputTrust": { "enum": ["trusted", "untrusted", "mixed"] },
    "confirmation": { "enum": ["none", "required"] },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": { "properties": { "effect": { "enum": ["consequential", "payment"] } } },
      "then": { "properties": { "confirmation": { "const": "required" } } }
    }
  ],
  "additionalProperties": false
}
